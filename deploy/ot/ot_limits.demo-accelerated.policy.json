{
  "schema": "remora-cumulative-limits/v1",
  "comment": "Accelerated-simulation variant, for runner.demo ONLY. REMORA measures limit windows on its own wall clock, while the demo compresses a simulated day into minutes; the production budgets (ot_limits.policy.json) would then refuse a normal day's changes as if they happened within one real hour (found 2026-10-27). Here the zone-01/02 window is 60 s with the same 4.0 degC budget, which bounds movement per simulated controller step at the demo's pace. Cumulative-limit behaviour itself is demonstrated in real time by the acceptance case LIM-01 with the production policy, never by this file.",
  "coverage": "all_writes",
  "meters": {
    "set_zone_setpoint": [
      {
        "quantity": "setpoint_movement",
        "kind": "change",
        "argument": "setpoint_c",
        "scale": 10,
        "unit": "decidegrees",
        "resource_argument": "zone_id",
        "observed": true,
        "previous_field": "previous_setpoint_c"
      }
    ],
    "set_zone_cooling_setpoint": [
      {
        "quantity": "cooling_movement",
        "kind": "change",
        "argument": "cooling_c",
        "scale": 10,
        "unit": "decidegrees",
        "resource_argument": "zone_id",
        "observed": true,
        "previous_field": "previous_setpoint_c"
      }
    ],
    "set_zone_co2_setpoint": [
      {
        "quantity": "co2_movement",
        "kind": "change",
        "argument": "co2_ppm",
        "scale": 1,
        "unit": "ppm",
        "resource_argument": "zone_id",
        "observed": true,
        "previous_field": "previous_setpoint_c"
      }
    ],
    "set_zone_lighting_setpoint": [
      {
        "quantity": "lux_movement",
        "kind": "change",
        "argument": "lux",
        "scale": 1,
        "unit": "lux",
        "resource_argument": "zone_id",
        "observed": true,
        "previous_field": "previous_setpoint_c"
      }
    ],
    "set_zone_lighting_mode": [
      {
        "quantity": "lighting_mode_changes",
        "kind": "count",
        "per_call": 1,
        "unit": "changes",
        "resource_argument": "zone_id"
      }
    ],
    "set_supply_air_setpoint": [
      {
        "quantity": "supply_air_changes",
        "kind": "count",
        "per_call": 1,
        "unit": "changes"
      }
    ],
    "set_tank_setpoint": [
      {
        "quantity": "tank_changes",
        "kind": "count",
        "per_call": 1,
        "unit": "changes"
      }
    ],
    "set_heat_pump_limit": [
      {
        "quantity": "hp_limit_changes",
        "kind": "count",
        "per_call": 1,
        "unit": "changes"
      }
    ],
    "set_ahu_enabled": [
      {
        "quantity": "ahu_changes",
        "kind": "count",
        "per_call": 1,
        "unit": "changes"
      }
    ],
    "set_heating_cable_mode": [
      {
        "quantity": "cable_mode_changes",
        "kind": "count",
        "per_call": 1,
        "unit": "changes",
        "resource_argument": "circuit"
      }
    ]
  },
  "limits": [
    {
      "limit_id": "zone-01-movement",
      "tenant": "ot-pilot",
      "quantity": "setpoint_movement",
      "unit": "decidegrees",
      "resource": "ZONE-01",
      "principal": "*",
      "max": 40,
      "window_seconds": 60
    },
    {
      "limit_id": "zone-02-movement",
      "tenant": "ot-pilot",
      "quantity": "setpoint_movement",
      "unit": "decidegrees",
      "resource": "ZONE-02",
      "principal": "*",
      "max": 40,
      "window_seconds": 60
    },
    {
      "limit_id": "zone-03-movement",
      "tenant": "ot-pilot",
      "quantity": "setpoint_movement",
      "unit": "decidegrees",
      "resource": "ZONE-03",
      "principal": "*",
      "max": 5,
      "window_seconds": 3600
    },
    {
      "limit_id": "zone-cooling-movement",
      "tenant": "ot-pilot",
      "quantity": "cooling_movement",
      "unit": "decidegrees",
      "resource": "*",
      "principal": "*",
      "max": 90,
      "window_seconds": 60
    },
    {
      "limit_id": "zone-co2-movement",
      "tenant": "ot-pilot",
      "quantity": "co2_movement",
      "unit": "ppm",
      "resource": "*",
      "principal": "*",
      "max": 200,
      "window_seconds": 60
    },
    {
      "limit_id": "zone-lux-movement",
      "tenant": "ot-pilot",
      "quantity": "lux_movement",
      "unit": "lux",
      "resource": "*",
      "principal": "*",
      "max": 750,
      "window_seconds": 60
    },
    {
      "limit_id": "zone-lighting-mode-changes",
      "tenant": "ot-pilot",
