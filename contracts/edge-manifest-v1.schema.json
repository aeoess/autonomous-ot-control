{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edge-manifest-v1",
  "title": "A federation edge's manifest (federation/edges/<id>/edge.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "edge_id",
    "project",
    "maintainer",
    "boundary",
    "mode",
    "pin",
    "licence",
    "claim_ceiling",
    "claims",
    "evaluator",
    "entrypoint"
  ],
  "properties": {
    "schema": {
      "const": "ot-edge-manifest/v1"
    },
    "edge_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
    },
    "project": {
      "type": "string"
    },
    "maintainer": {
      "type": "string",
      "description": "GitHub handle of the person who opened the joining pull request."
    },
    "repository": {
      "type": "string"
    },
    "boundary": {
      "enum": [
        "effect_evidence",
        "corpus_adequacy",
        "runner_validity",
        "admission_runtime",
        "tool_definition",
        "authority_fixture"
      ]
    },
    "mode": {
      "enum": [
        "offline",
        "inline"
      ]
    },
    "pin": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git_commit",
            "image_digest",
            "package"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "licence": {
      "type": "string"
    },
    "claim_ceiling": {
      "type": "string",
      "description": "What a green result shows, and what it does not, in the edge's own words."
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "description": "The claims this edge checks, one ceiling each. Claim ids from the fixture manifest let the scorer report per claim.",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_ceiling"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "claim_ceiling": {
            "type": "string"
          }
        }
      }
    },
    "evaluator": {
      "type": "object",
      "description": "What the adapter is. The independence level of a run is derived from this, the operator and the host; it is never declared.",
      "required": [
        "kind",
        "imports_reference_verifier",
        "imports_testbed_code"
      ],
      "properties": {
        "kind": {
          "enum": [
            "reference",
            "second_implementation"
          ]
        },
        "imports_reference_verifier": {
          "type": "boolean"
        },
        "imports_testbed_code": {
          "type": "boolean"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image": {
          "type": "string"
        },
        "http": {
          "type": "string",
          "description": "inline only: the /decide URL inside the edge container"
        }
      }
    }
  }
}
