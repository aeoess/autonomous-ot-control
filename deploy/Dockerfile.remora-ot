# Protected REMORA execution image + deployment-owned OT adapter (OT-003/OT-004).
#
# Modeled on the upstream reference deploy/ot-pilot/Dockerfile at the pinned
# commit (upstream/remora.lock.json): it runs `uvicorn servers.api:app` in
# REMORA_ENV=production, so the fail-closed prerequisites (durable execution
# state, durable envelope store, token table) are binding at startup. This is
# the ONLY image that holds the twin actuator credential and the ONLY process on
# the plant-private network.
#
# Status: IMPLEMENTED, NOT_ESTABLISHED as a build/run. Building needs the pinned
# REMORA upstream (public). The deployment-owned tool registry and semantic
# bundle below are reconciled against the pinned server registration contract
# (servers/tool_registry_research.py, servers/execution_api.py). Do NOT bake
# credentials or signing keys into the image; compose injects them at runtime.
ARG REMORA_REPO=https://github.com/darklordVirtual/REMORA-research
ARG REMORA_COMMIT=9b1763cabcc23f8bbdd2f629600ebee68ca0f08c

FROM python:3.12-slim AS remora-src
ARG REMORA_REPO
ARG REMORA_COMMIT
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git init -q remora \
    && cd remora \
    && git remote add origin "${REMORA_REPO}" \
    && git fetch --depth 1 origin "${REMORA_COMMIT}" \
    && git checkout -q FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${REMORA_COMMIT}"

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/app
WORKDIR /app

# Install the pinned REMORA with the execution-surface extras, matching the
# upstream OT pilot image (API server, PostgreSQL authority store, crypto).
COPY --from=remora-src /src/remora /opt/remora
RUN pip install --upgrade pip \
 && pip install -e "/opt/remora[api,postgres,security]"

# The OT registry reaches the twin over httpx, which REMORA's extras do not
# install. Without it the registry fails to import at the first dispatch, after
# the approval was already spent (found by the first live governed run).
COPY deploy/ot/requirements-adapter.lock /tmp/requirements-adapter.lock
RUN pip install --require-hashes --no-deps -r /tmp/requirements-adapter.lock \
 && python -c "import httpx"

# Deployment-owned modules (not shipped package code): the OT tool registry,
# the semantic bundle, the intent (work-order) source, and the reference
# cumulative-limits policy. Named like the upstream ot-pilot deployment files.
COPY deploy/ot/ot_registry.py /app/ot_registry.py
COPY deploy/ot/ot_bundle.py /app/ot_bundle.py
COPY deploy/ot/ot_intents.json /app/ot_intents.json
COPY deploy/ot/ot_limits.policy.json /app/ot_limits.policy.json
# The deploy-time signer (governed-bootstrap.sh runs it with --network none).
# The runtime never executes it and never holds its seeds.
COPY deploy/ot/sign_deployment.py /app/sign_deployment.py

# The OT adapter helpers the registry closes over, plus the twin schema helpers
# and the signed ToolSpec they bind. Only the pieces the execution side needs —
# no effect_observer/server (those run on the proposing/observer side).
COPY adapter/__init__.py adapter/contracts.py adapter/actuation.py /app/adapter/
COPY twin/__init__.py twin/state.py /app/twin/
COPY contracts /app/contracts

ENV REMORA_TOOL_REGISTRY_MODULE=ot_registry \
    REMORA_SEMANTIC_BUNDLE_MODULE=ot_bundle \
    REMORA_ENABLED_SURFACES=execution \
    OT_TOOLSPEC_PATH=/app/contracts/ot-toolspec-v1.json

RUN useradd --create-home --uid 10002 remora \
 && mkdir -p /var/lib/remora/artifacts \
 && chown -R remora:remora /var/lib/remora /app
USER remora

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/v1/ready', timeout=4).status == 200 else 1)"

CMD ["uvicorn", "servers.api:app", "--host", "0.0.0.0", "--port", "8000"]
