# Placeholders only. run-demo.sh writes a gitignored .env with random dev tokens.
# Never commit real values. The twin refuses placeholder/short/duplicate tokens.
TWIN_READ_TOKEN=placeholder-read-token-not-valid
TWIN_ACTUATOR_TOKEN=placeholder-actuator-token-not-valid
TWIN_CONTROL_TOKEN=placeholder-control-token-not-valid

# Governed profile (PR 2, OT-003 + OT-004) only. Dev values; never commit real
# ones. Generate them with: ./deploy/scripts/governed-bootstrap.sh
#
# REMORA role-separated tokens: operator proposes (cannot approve); approver and
# supervisor are admins; viewer is read-only. The operator token is also the
# proposing runner's SDK bearer — it never grants actuator access.
REMORA_OPERATOR_TOKEN=placeholder-operator-token-not-valid
REMORA_APPROVER_TOKEN=placeholder-approver-token-not-valid
REMORA_SUPERVISOR_TOKEN=placeholder-supervisor-token-not-valid
REMORA_VIEWER_TOKEN=placeholder-viewer-token-not-valid
# REMORA authority store (PostgreSQL) and durable envelope store.
REMORA_PG_DB=remora
REMORA_PG_USER=remora
REMORA_PG_PASSWORD=placeholder-pg-password-not-valid
# REMORA signing keys (local dev values; inject from a vault in production).
REMORA_PDP_SIGNING_KEY=placeholder-pdp-key-not-valid
REMORA_LEASE_SIGNING_KEY=placeholder-lease-key-not-valid
REMORA_AUDIT_SIGNING_KEY=placeholder-audit-key-not-valid
REMORA_ENVELOPE_SIGNING_KEY=placeholder-envelope-key-not-valid
# Pinned upstream (must match upstream/remora.lock.json); override REMORA_REPO
# only if mirroring the pinned commit elsewhere.
REMORA_REPO=https://github.com/darklordVirtual/REMORA-research
REMORA_COMMIT=2594d08b592e61f3d0f436671a230faaa311db9a
