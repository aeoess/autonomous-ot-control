      "max": 40,
      "window_seconds": 60
    },
    {
      "limit_id": "supply-air-changes",
      "tenant": "ot-pilot",
      "quantity": "supply_air_changes",
      "unit": "changes",
      "principal": "*",
      "max": 40,
      "window_seconds": 60
    },
    {
      "limit_id": "tank-changes",
      "tenant": "ot-pilot",
      "quantity": "tank_changes",
      "unit": "changes",
      "principal": "*",
      "max": 40,
      "window_seconds": 60
    },
    {
      "limit_id": "hp-limit-changes",
      "tenant": "ot-pilot",
      "quantity": "hp_limit_changes",
      "unit": "changes",
      "principal": "*",
      "max": 40,
      "window_seconds": 60
    },
    {
      "limit_id": "ahu-changes",
      "tenant": "ot-pilot",
      "quantity": "ahu_changes",
      "unit": "changes",
      "principal": "*",
      "max": 40,
      "window_seconds": 60
    },
    {
      "limit_id": "cable-mode-changes",
      "tenant": "ot-pilot",
      "quantity": "cable_mode_changes",
      "unit": "changes",
      "resource": "*",
      "principal": "*",
      "max": 40,
      "window_seconds": 60
    }
  ]
}
