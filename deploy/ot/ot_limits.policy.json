{
  "schema": "remora-cumulative-limits/v1",
  "comment": "Reference cumulative-limits policy for the OT setpoint pilot (UNSIGNED). REMORA verifies a SIGNED envelope (remora-cumulative-limits-signed/v1): sign this with the authority Ed25519 key via REMORA's scripts/sign_limit_policy.py, publish only the public key in REMORA_LIMITS_TRUSTED_KEYS, and set REMORA_REQUIRE_LIMITS=1 to enforce. Movement is observed from the twin (ot_registry.observe_limit_value), not from what REMORA last allowed. ZONE-03 is the sensitive laboratory zone: its REMORA budget (5 decidegrees, 0.5 degC, per hour) is deliberately tighter than the twin interlock (1.0 degC per change, 2 changes per hour), so the acceptance suite can show the REMORA layer refusing what the interlock alone would allow.",
  "coverage": "all_writes",
  "meters": {
    "set_zone_setpoint": [
      {
        "quantity": "setpoint_movement",
        "kind": "change",
        "argument": "setpoint_c",
        "scale": 10,
        "unit": "decidegrees",
        "resource_argument": "zone_id",
        "observed": true,
        "previous_field": "previous_setpoint_c"
      }
    ],
    "set_zone_cooling_setpoint": [
      {
        "quantity": "cooling_movement",
        "kind": "change",
        "argument": "cooling_c",
        "scale": 10,
        "unit": "decidegrees",
        "resource_argument": "zone_id",
        "observed": true,
        "previous_field": "previous_setpoint_c"
      }
    ],
    "set_zone_co2_setpoint": [
      {
        "quantity": "co2_movement",
        "kind": "change",
        "argument": "co2_ppm",
        "scale": 1,
        "unit": "ppm",
        "resource_argument": "zone_id",
        "observed": true,
        "previous_field": "previous_setpoint_c"
      }
    ],
    "set_zone_lighting_setpoint": [
      {
        "quantity": "lux_movement",
        "kind": "change",
        "argument": "lux",
        "scale": 1,
        "unit": "lux",
        "resource_argument": "zone_id",
        "observed": true,
        "previous_field": "previous_setpoint_c"
      }
    ],
    "set_zone_lighting_mode": [
      {
        "quantity": "lighting_mode_changes",
        "kind": "count",
        "per_call": 1,
        "unit": "changes",
        "resource_argument": "zone_id"
      }
    ],
    "set_supply_air_setpoint": [
      {
        "quantity": "supply_air_changes",
        "kind": "count",
        "per_call": 1,
        "unit": "changes"
      }
    ],
    "set_tank_setpoint": [
      {
        "quantity": "tank_changes",
        "kind": "count",
        "per_call": 1,
        "unit": "changes"
      }
    ],
    "set_heat_pump_limit": [
      {
        "quantity": "hp_limit_changes",
        "kind": "count",
        "per_call": 1,
        "unit": "changes"
      }
    ],
    "set_ahu_enabled": [
      {
        "quantity": "ahu_changes",
        "kind": "count",
        "per_call": 1,
        "unit": "changes"
      }
    ],
    "set_heating_cable_mode": [
      {
        "quantity": "cable_mode_changes",
        "kind": "count",
        "per_call": 1,
        "unit": "changes",
        "resource_argument": "circuit"
      }
    ]
  },
  "limits": [
