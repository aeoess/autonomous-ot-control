          "audit"
        ],
        "additionalProperties": false
      },
      "RejectChangeInput": {
        "type": "object",
        "properties": {
          "review_item_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 3
          }
        },
        "required": [
