          "reason"
        ],
        "additionalProperties": false
      },
      "RejectChangeOutput": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "audit": {
            "$ref": "#/components/schemas/AuditRef"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "GetChangeStatusInput": {
        "type": "object",
        "properties": {
          "proposal_id": {
            "type": "string"
          }
        },
        "required": [
          "proposal_id"
        ],
        "additionalProperties": false
      },
      "GetChangeStatusOutput": {
        "type": "object",
        "properties": {
          "proposal_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ASSESSED",
              "WAITING_APPROVAL",
              "APPROVED",
              "DISPATCHED",
              "APPLIED",
              "REFUSED",
              "UNKNOWN",
              "EFFECT_VERIFIED",
              "EFFECT_MISMATCH",
              "EFFECT_UNOBSERVABLE"
            ]
          },
          "observed": {
            "type": [
              "object",
              "null"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "proposal_id",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "x-mcp-tools": [
    {
      "name": "get_building_status",
      "description": "Current mode, zone temperatures and setpoints, plant state, active plan, open alerts.",
      "scope": "building.read",
      "remora_call": "none",
      "plant_effect": "none",
      "inputSchema": {
        "$ref": "#/components/schemas/GetBuildingStatusInput"
      },
      "outputSchema": {
        "$ref": "#/components/schemas/GetBuildingStatusOutput"
      }
    },
    {
      "name": "get_datapoints",
      "description": "Latest values of catalogued data points (docs/datapoints.md), with sample time and quality.",
      "scope": "building.read",
      "remora_call": "none",
      "plant_effect": "none",
      "inputSchema": {
        "$ref": "#/components/schemas/GetDatapointsInput"
      },
      "outputSchema": {
        "$ref": "#/components/schemas/GetDatapointsOutput"
      }
    },
    {
      "name": "get_prices_and_forecast",
      "description": "Day-ahead spot prices and the weather forecast the caretaker planned on, with snapshot SHA-256.",
      "scope": "building.read",
      "remora_call": "none",
      "plant_effect": "none",
      "inputSchema": {
        "$ref": "#/components/schemas/GetPricesAndForecastInput"
      },
      "outputSchema": {
        "$ref": "#/components/schemas/GetPricesAndForecastOutput"
      }
    },
    {
      "name": "get_report",
      "description": "Energy, cost, comfort, hazards and savings against the reference schedule, for a period.",
      "scope": "reports.read",
      "remora_call": "none",
      "plant_effect": "none",
      "inputSchema": {
        "$ref": "#/components/schemas/GetReportInput"
      },
      "outputSchema": {
        "$ref": "#/components/schemas/GetReportOutput"
      }
    },
    {
      "name": "get_decision",
      "description": "The full audit trail of one decision: ledger row, REMORA lifecycle and evidence manifest, effect verification.",
      "scope": "reports.read",
      "remora_call": "GET /v1/execution/proposals/{id}/lifecycle and /evidence",
      "plant_effect": "none",
      "inputSchema": {
        "$ref": "#/components/schemas/GetDecisionInput"
