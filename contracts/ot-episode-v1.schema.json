{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ot-episode-v1",
  "title": "A federation A/B/C episode (ADR-004): one workload for every arm, with the oracle written before any run",
  "type": "object",
  "required": [
    "schema",
    "episode_id",
    "twin_config",
    "twin_config_sha256",
    "scenario",
    "scenario_sha256",
    "strategy",
    "days",
    "simulated_s",
    "step_seconds",
    "reviewer_models",
    "pins",
    "work_orders",
    "tables",
    "rules",
    "totals",
    "proposals",
    "oracle_note"
  ],
  "properties": {
    "schema": {
      "const": "ot-episode/v1"
    },
    "episode_id": {
      "type": "string"
    },
    "twin_config": {
      "type": "string"
    },
    "twin_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenario": {
      "type": "string"
    },
    "scenario_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strategy": {
      "type": "string"
    },
    "days": {
      "type": "integer",
      "minimum": 1
    },
    "simulated_s": {
      "type": "integer"
    },
    "step_seconds": {
      "type": "integer"
    },
    "reviewer_models": {
      "type": "array",
      "items": {
        "enum": [
          "careful",
          "rubber_stamp"
        ]
      }
    },
    "attack_at_sim_s": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pins": {
      "type": "object",
      "description": "What a scored run holds fixed; runner.episode check fails when any of it drifts.",
      "additionalProperties": false,
      "required": [
        "remora_commit",
        "remora_lock_sha256",
        "toolspec_sha256",
        "limits_policy_sha256",
        "oracle_sha256",
        "initial_twin_state",
        "seeds",
        "seeds_note"
      ],
      "properties": {
        "remora_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "remora_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolspec_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "limits_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "oracle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "initial_twin_state": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "seeds_note": {
          "type": "string"
        }
      }
    },
    "work_orders": {
      "type": "object",
      "description": "intent_ref -> what it permits: zones with their permitted values. The oracle reads only this.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "zones"
        ],
        "properties": {
          "zones": {
            "type": "object",
            "description": "zone -> the permitted values: a list, or an inclusive range {min, max}.",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    }
                  }
                }
              ]
            }
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "tables": {
      "type": "object",
      "description": "The plant's declared limits the oracle judges against: signed contract bounds and step, cumulative budgets.",
      "required": [
        "zones",
        "setpoint_min_c",
        "setpoint_max_c",
        "max_delta_c",
        "budgets"
      ]
    },
    "rules": {
      "type": "object",
      "description": "rule id -> meaning (ADR-004).",
      "additionalProperties": {
        "type": "string"
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "proposals",
        "permitted",
        "forbidden",
        "by_rule",
        "by_origin"
      ]
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "at_sim_s",
          "origin",
          "call",
          "oracle"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "at_sim_s": {
            "type": "integer"
          },
          "origin": {
            "type": "string",
            "pattern": "^(schedule|injected:[a-z_]+)$"
          },
          "intent_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "call": {
            "type": "object",
            "required": [
              "tool_name",
              "arguments"
            ]
          },
          "from_c": {
            "type": "number"
          },
          "delegation_fault": {
            "enum": [
              "widened",
              "expired",
              "out_of_scope"
            ],
            "description": "Set when the episode is built: the delegation presented for this call is widened, expired at the decision time, or outside the granted scope. The oracle's ground truth for delegation_invalid; never read from a verifier."
          },
          "replay_of": {
            "type": "string"
          },
          "approved_call": {
            "type": "object"
          },
          "plant_interlock": {
            "type": "string"
          },
          "strategy_reason": {
            "type": "string"
          },
          "oracle": {
            "type": "object",
            "required": [
              "verdict",
              "rule",
              "reason"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "permitted",
                  "forbidden"
                ]
              },
              "rule": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  null,
                  "unauthorized",
                  "delegation_invalid",
                  "outside_work_order",
                  "outside_contract",
                  "over_authority_budget",
                  "duplicate_effect",
                  "not_the_approved_call",
                  "stale_basis",
                  "basis_not_verified_data"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "oracle_note": {
      "type": "string"
    }
  }
}
