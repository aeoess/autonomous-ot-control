# Placeholders only. run-demo.sh writes a gitignored .env with random dev tokens.
# Never commit real values. The twin refuses placeholder/short/duplicate tokens.
TWIN_READ_TOKEN=placeholder-read-token-not-valid
TWIN_ACTUATOR_TOKEN=placeholder-actuator-token-not-valid
TWIN_CONTROL_TOKEN=placeholder-control-token-not-valid

# Governed profile (PR 2, OT-003 + OT-004) only. Dev values; never commit real ones.
# REMORA_OPERATOR_TOKEN is the proposing runner's role-restricted SDK token — it
# never grants actuator access. OT_TOOLSPEC_SIGNING_KEY attests the signed
# ToolSpec at deploy time. PostgreSQL holds REMORA's authority state.
REMORA_OPERATOR_TOKEN=placeholder-operator-token-not-valid
OT_TOOLSPEC_SIGNING_KEY=placeholder-signing-key-not-valid
REMORA_PG_DB=remora
REMORA_PG_USER=remora
REMORA_PG_PASSWORD=placeholder-pg-password-not-valid
# Pinned upstream (must match upstream/remora.lock.json); override REMORA_REPO
# only if mirroring the pinned commit elsewhere.
REMORA_REPO=https://github.com/darklordVirtual/REMORA-research
REMORA_COMMIT=2594d08b592e61f3d0f436671a230faaa311db9a
