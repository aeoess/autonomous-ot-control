{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "federation-fixtures-v1",
  "title": "A sealed federation fixture set (federation/fixtures/<set>/manifest.json)",
  "type": "object",
  "required": [
    "schema",
    "fixture_set",
    "testbed_commit",
    "scope",
    "claims",
    "cases",
    "files",
    "package_digest",
    "package_digest_rule",
    "digest_rules"
  ],
  "properties": {
    "schema": {
      "const": "ot-federation-fixtures/v1"
    },
    "fixture_set": {
      "type": "string"
    },
    "testbed_commit": {
      "type": "string",
      "description": "The autonomous-ot-control revision the trails were recorded on. Source provenance, not package identity."
    },
    "testbed_commit_note": {
      "type": "string"
    },
    "source_run": {
      "type": "string"
    },
    "derived_from": {
      "type": "string",
      "description": "For a derived set: the fixture set whose cases were copied byte for byte."
    },
    "source_trails_commit": {
      "type": "string",
      "description": "For a derived set: the revision the copied trails were recorded on (the source's testbed_commit)."
    },
    "added_faults": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "For a derived set: the faults seeded in this set and not in its source."
    },
    "derivation_note": {
      "type": "string"
    },
    "sealed_against": {
      "type": "object",
      "description": "The verifier and scorer this set was sealed against: an existing, earlier commit and the SHA-256 of the two files at that commit. Never the commit that contains this manifest. Checked by runner.edge_check --check-provenance, which fetches the files from history, compares the digests, runs that verifier and requires every expected verdict.",
      "required": [
        "verifier_commit",
        "verifier_path",
        "verifier_sha256",
        "scorer_path",
        "scorer_sha256"
      ],
      "properties": {
        "verifier_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "verifier_path": {
          "type": "string"
        },
        "verifier_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scorer_path": {
          "type": "string"
        },
        "scorer_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "statement"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "kind",
          "fault",
          "claim_id",
          "expected_verdict"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "positive",
              "negative"
            ]
          },
          "fault": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "For a negative case, the claim its seeded fault contradicts; null for a positive case."
          },
          "expected_verdict": {
            "enum": [
              "ESTABLISHED",
              "CONTRADICTED",
              "NOT_ESTABLISHED"
            ]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "Every case file with its SHA-256. The package identity is these bytes, not a Git revision.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^cases/[^/]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "package_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "package_digest_rule": {
      "type": "string"
    },
    "digest_rules": {
      "type": "object",
      "required": [
        "evidence_sha256",
        "fixtures_sha256"
      ]
    }
  }
}
