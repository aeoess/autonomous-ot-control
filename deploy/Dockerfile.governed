# Proposing-side governed runner (OT-003). Holds the pinned remora.sdk client
# and a role-restricted operator token — NO actuator credential, no plant-private
# route. It proposes to REMORA; only REMORA's dispatcher reaches the actuator.
#
# remora.sdk has no heavy third-party dependencies at the pinned commit (the
# package's base dependency set is empty), so this installs the pinned REMORA
# for its SDK plus this project's hash-locked runtime deps (httpx etc.).
ARG REMORA_REPO=https://github.com/darklordVirtual/REMORA-research
ARG REMORA_COMMIT=123a5fd033bd1192fad05d366ec5263eb66c17b7

FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9 AS remora-src
ARG REMORA_REPO
ARG REMORA_COMMIT
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git init -q remora \
    && cd remora \
    && git remote add origin "${REMORA_REPO}" \
    && git fetch --depth 1 origin "${REMORA_COMMIT}" \
    && git checkout -q FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${REMORA_COMMIT}"

# REMORA's SDK built into a wheel with its build backend from a hash-locked file, so nothing is fetched
# unpinned and the build tools never reach the final image (SDD-OT-002 SR-21).
FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9 AS remora-wheel
COPY deploy/requirements-build.lock /tmp/requirements-build.lock
RUN pip install --require-hashes --no-deps -r /tmp/requirements-build.lock
COPY --from=remora-src /src/remora /opt/remora
RUN pip wheel --no-deps --no-build-isolation -w /wheels /opt/remora

FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/app
WORKDIR /app

COPY requirements.lock /app/requirements.lock
RUN pip install --require-hashes --no-deps -r /app/requirements.lock

# The pinned REMORA SDK (client transport only; it mints no authority), from the wheel built above.
COPY --from=remora-wheel /wheels /tmp/wheels
RUN pip install --no-deps /tmp/wheels/*.whl && rm -rf /tmp/wheels

COPY twin /app/twin
COPY runner /app/runner
COPY adapter /app/adapter
COPY contracts /app/contracts
COPY upstream /app/upstream

RUN useradd --create-home --uid 10001 runner
USER runner
WORKDIR /work
ENTRYPOINT ["python", "-m"]
CMD ["runner.governed", "--help"]
